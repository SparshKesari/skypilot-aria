# Copy to .env and fill in the Anthropic key (the agent runs on Claude Opus 5.5).
ANTHROPIC_API_KEY=
# Only if the Anthropic key is org-level (not workspace-scoped): the workspace ID to bill to
ANTHROPIC_WORKSPACE_ID=

# strict: tools enforce identity checks (public demo). off: only the model does (benchmark runs).
GUARDRAILS=strict
PORT=8080

# LambdaTest / TestMu AI (agent testing, tunnel)
LT_USERNAME=
LT_ACCESS_KEY=

# Agent API key required on hosted deployments (header x-api-key); leave empty locally to disable
A2A_API_KEY=
