    {
      "type": "function",
      "function": {
        "name": "quote_cancellation",
        "description": "Price a cancellation: amount paid, fees, refund, refundable extras, method options and timelines. Does not cancel.",
        "parameters": {
          "type": "object",
          "properties": {
